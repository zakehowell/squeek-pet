{
  "name": "squeek-pet",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "description": "A desktop hamster that moves with Squeektoshi's real wheel on SqueekChain (Sepolia).",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "build:world": "npm run typecheck && vite build --config vite.world.config.ts",
    "deploy:page": "echo \"Open http://127.0.0.1:1420/contracts/deploy/ in the browser that has your wallet\" && vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.7.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.20.5",
    "ethers": "6.17.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.19"
  }
}
