{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Squeek Pet",
  "version": "0.1.1",
  "identifier": "xyz.squeekpulse.pet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "pet",
        "create": false,
        "url": "index.html",
        "title": "Squeek Pet",
        "width": 300,
        "height": 380,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "focus": false,
        "visible": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https://api.squeekchain.com https://media.squeekchain.com",
        "object-src": "'none'",
        "base-uri": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Entertainment",
    "shortDescription": "A desktop hamster synced to Squeektoshi's real wheel",
    "longDescription": "Squeek Pet is a desktop hamster that runs, sleeps and eats glowing data beans in step with Squeektoshi's real hamster wheel on SqueekChain (Sepolia testnet). Read-only: no wallet, no signatures.",
    "copyright": "MIT licensed",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
