{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the pet and settings windows may do. Links only open Squeek Pulse, the SqueekChain docs, the Sepolia explorer and @squeekchain's live stream on X.",
  "windows": ["pet", "settings"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-always-on-top",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://squeekpulse.xyz/*" },
        { "url": "https://docs.squeekchain.com/*" },
        { "url": "https://eth-sepolia.blockscout.com/*" },
        { "url": "https://x.com/squeekchain" },
        { "url": "https://x.com/i/broadcasts/*" }
      ]
    },
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}
